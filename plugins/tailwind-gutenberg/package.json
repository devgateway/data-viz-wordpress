{
  "name": "tailwind-gutenberg",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-2.0-or-later",
  "description": "Editor integration for the Tailwind Classes for Gutenberg plugin.",
  "author": "Development Gateway",
  "scripts": {
    "build": "wp-scripts build js/editor.js js/canvas.js js/worker.js && mkdir -p build && cp node_modules/@tailwindcss/browser/dist/index.global.js build/tailwindcss-browser.js",
    "start": "wp-scripts start js/editor.js js/canvas.js js/worker.js",
    "build:index": "node tools/generate-index.mjs",
    "lint:js": "wp-scripts lint-js"
  },
  "devDependencies": {
    "@wordpress/scripts": "^30.25.0",
    "tailwindcss": "^4.3.3"
  },
  "dependencies": {
    "@tailwindcss/browser": "^4.3.3",
    "@wordpress/api-fetch": "^7.32.0",
    "@wordpress/block-editor": "^15.5.0",
    "@wordpress/blocks": "^15.5.0",
    "@wordpress/components": "^30.5.0",
    "@wordpress/compose": "^7.32.0",
    "@wordpress/data": "^10.32.0",
    "@wordpress/editor": "^14.32.0",
    "@wordpress/element": "^6.32.0",
    "@wordpress/hooks": "^4.32.0",
    "@wordpress/i18n": "^6.5.0",
    "@wordpress/icons": "^10.32.0",
    "@wordpress/keyboard-shortcuts": "^5.32.0",
    "classnames": "^2.5.1"
  }
}
